{
  "format": 3,
  "id": "com.decker.profiles",
  "name": "Profiles",
  "version": "3.0.0",
  "author": "Decker",
  "description": "Keys for moving between a device's profiles.",
  "homepage": "https://github.com/valsr/decker-plugins",
  "icon": "icons/profiles",
  "category": "Utilities",
  "decker": ">=0.7",
  "runtime": {
    "type": "python",
    "entry": "plugin.py"
  },
  "contributes": {
    "actions": [
      {
        "id": "com.decker.profiles.next",
        "name": "Next profile",
        "tooltip": "Go to the next profile",
        "icon": "icons/profiles",
        "scope": "global",
        "settings": [
          {
            "key": "wrap",
            "type": "bool",
            "label": "Wrap around",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.profiles.previous",
        "name": "Previous profile",
        "tooltip": "Go to the previous profile",
        "icon": "icons/profiles",
        "scope": "global",
        "settings": [
          {
            "key": "wrap",
            "type": "bool",
            "label": "Wrap around",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.profiles.goto",
        "name": "Go to profile",
        "tooltip": "Go to a chosen profile; shows its icon",
        "icon": "icons/profiles",
        "scope": "global",
        "settings": [
          {
            "key": "profile",
            "type": "profile",
            "label": "Profile"
          }
        ]
      }
    ]
  }
}
