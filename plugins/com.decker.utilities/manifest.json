{
  "format": 3,
  "id": "com.decker.utilities",
  "name": "Utilities",
  "version": "2.1.2",
  "author": "Decker",
  "description": "Brightness, sleep, timer, stopwatch, counter, page and profile keys.",
  "homepage": "https://github.com/valsr/decker-plugins",
  "icon": "fas:toolbox",
  "category": "Utilities",
  "decker": ">=0.8.1",
  "platforms": [
    "linux",
    "windows",
    "macos"
  ],
  "runtime": {
    "type": "python",
    "entry": "plugin.py",
    "requirements": [
      "pillow>=12",
      "screen-brightness-control; sys_platform != \"darwin\"",
      "jeepney; sys_platform == \"linux\""
    ]
  },
  "contributes": {
    "cards": [
      {
        "id": "com.decker.utilities.counter",
        "name": "Counter",
        "tooltip": "Press to count up, double press to count down, long press to reset",
        "icon": "fas:calculator",
        "actions": ["com.decker.utilities.counter-increment", "com.decker.utilities.counter-decrement", "com.decker.utilities.counter-reset"],
        "appearance": {
          "background": "#1f618d"
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.counter-increment",
            "args": {
              "step": 1
            }
          },
          "double_press": {
            "action": "com.decker.utilities.counter-decrement",
            "args": {
              "step": 1
            }
          },
          "long_press": {
            "action": "com.decker.utilities.counter-reset"
          }
        },
        "settings": [
          {
            "section": "Counting"
          },
          {
            "key": "max",
            "type": "int",
            "label": "Max count",
            "default": 0,
            "min": 0,
            "max": 99999,
            "special_value": "∞ (no limit)"
          }
        ]
      },
      {
        "id": "com.decker.utilities.brightness-level",
        "name": "Brightness Level",
        "tooltip": "Shows the display brightness; press to raise it, double press to lower it, long press to set it to 75%",
        "icon": "fas:sun",
        "appearance": {
          "background": "#000000"
        },
        "settings": [
          {
            "key": "monitor",
            "type": "choice",
            "label": "Monitor",
            "default": "all",
            "options": [
              {
                "label": "All monitors",
                "value": "all"
              }
            ],
            "options_source": "monitors"
          }
        ],
        "bindings": {
          "press": {
            "action": "com.decker.utilities.brightness",
            "args": {
              "mode": "increase",
              "value": 10
            }
          },
          "double_press": {
            "action": "com.decker.utilities.brightness",
            "args": {
              "mode": "decrease",
              "value": 10
            }
          },
          "long_press": {
            "action": "com.decker.utilities.brightness",
            "args": {
              "mode": "set",
              "value": 75
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.deck-brightness-level",
        "name": "Deck Brightness Level",
        "tooltip": "Shows the Stream Deck's brightness; press to raise it, double press to lower it, long press to set it to 75%",
        "icon": "fas:toolbox",
        "appearance": {
          "background": "#000000"
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.deck-brightness",
            "args": {
              "mode": "increase",
              "value": 10
            }
          },
          "double_press": {
            "action": "com.decker.utilities.deck-brightness",
            "args": {
              "mode": "decrease",
              "value": 10
            }
          },
          "long_press": {
            "action": "com.decker.utilities.deck-brightness",
            "args": {
              "mode": "set",
              "value": 75
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.sleep",
        "name": "Sleep",
        "tooltip": "Press to sleep now (or cancel a countdown), double press to sleep in 1 minute, long press to sleep in 10 minutes",
        "icon": "fas:moon",
        "actions": ["com.decker.utilities.sleep-press", "com.decker.utilities.sleep-after"],
        "appearance": {
          "background": "#000000"
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.sleep-press"
          },
          "double_press": {
            "action": "com.decker.utilities.sleep-after",
            "args": {
              "minutes": 1
            }
          },
          "long_press": {
            "action": "com.decker.utilities.sleep-after",
            "args": {
              "minutes": 10
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.timer",
        "name": "Timer",
        "tooltip": "A countdown timer: press to start, pause or resume it, double or long press to reset it; it rings when it ends",
        "icon": "fas:stopwatch",
        "actions": ["com.decker.utilities.timer-toggle", "com.decker.utilities.timer-reset"],
        "appearance": {
          "background": "#000000"
        },
        "settings": [
          {
            "key": "minutes",
            "type": "int",
            "label": "Minutes",
            "default": 5,
            "min": 0,
            "max": 1440
          },
          {
            "key": "seconds",
            "type": "int",
            "label": "Seconds",
            "default": 0,
            "min": 0,
            "max": 59
          },
          {
            "key": "show_time",
            "type": "bool",
            "label": "Show time",
            "default": true
          },
          {
            "key": "show_progress",
            "type": "bool",
            "label": "Show progress",
            "default": true
          },
          {
            "key": "progress_type",
            "type": "choice",
            "label": "Progress",
            "default": "circle",
            "options": [
              {
                "label": "Circle",
                "value": "circle"
              },
              {
                "label": "Bar",
                "value": "bar"
              }
            ]
          },
          {
            "key": "color_mode",
            "type": "choice",
            "label": "Colour mode",
            "default": "solid",
            "options": [
              {
                "label": "Solid",
                "value": "solid"
              },
              {
                "label": "Two colours (second at 20% left)",
                "value": "bicolor"
              },
              {
                "label": "Gradient",
                "value": "gradient"
              }
            ]
          },
          {
            "key": "color",
            "type": "color",
            "label": "Colour",
            "default": "#2ecc71"
          },
          {
            "key": "color_2",
            "type": "color",
            "label": "Second colour",
            "default": "#e74c3c"
          },
          {
            "key": "line_width",
            "type": "int",
            "label": "Line width",
            "default": 6,
            "min": 1,
            "max": 20
          }
        ],
        "bindings": {
          "press": {
            "action": "com.decker.utilities.timer-toggle"
          },
          "double_press": {
            "action": "com.decker.utilities.timer-reset"
          },
          "long_press": {
            "action": "com.decker.utilities.timer-reset"
          }
        }
      },
      {
        "id": "com.decker.utilities.stopwatch",
        "name": "Stopwatch",
        "tooltip": "A stopwatch: press to start or pause it, double or long press to reset it",
        "icon": "fas:stopwatch",
        "actions": ["com.decker.utilities.stopwatch-toggle", "com.decker.utilities.stopwatch-reset"],
        "appearance": {
          "background": "#000000"
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.stopwatch-toggle"
          },
          "double_press": {
            "action": "com.decker.utilities.stopwatch-reset"
          },
          "long_press": {
            "action": "com.decker.utilities.stopwatch-reset"
          }
        }
      }
    ],
    "actions": [
      {
        "id": "com.decker.utilities.counter-increment",
        "name": "Count up",
        "tooltip": "Adds the step to the Counter card's count",
        "icon": "fas:calculator",
        "scope": "plugin",
        "settings": [
          {
            "key": "step",
            "type": "int",
            "label": "Step",
            "default": 1,
            "min": 1,
            "max": 9999
          }
        ]
      },
      {
        "id": "com.decker.utilities.counter-decrement",
        "name": "Count down",
        "tooltip": "Subtracts the step from the Counter card's count",
        "icon": "fas:calculator",
        "scope": "plugin",
        "settings": [
          {
            "key": "step",
            "type": "int",
            "label": "Step",
            "default": 1,
            "min": 1,
            "max": 9999
          }
        ]
      },
      {
        "id": "com.decker.utilities.counter-reset",
        "name": "Reset count",
        "tooltip": "Sets the Counter card's count back to 0",
        "icon": "fas:calculator",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.utilities.page",
        "name": "Page",
        "tooltip": "Go to the next or previous page, or to a chosen one",
        "icon": "fas:file",
        "scope": "global",
        "settings": [
          {
            "key": "mode",
            "type": "choice",
            "label": "Go to",
            "default": "next",
            "options": [
              {
                "label": "A chosen page",
                "value": "page"
              },
              {
                "label": "Next page",
                "value": "next"
              },
              {
                "label": "Previous page",
                "value": "previous"
              }
            ]
          },
          {
            "key": "profile",
            "type": "profile",
            "label": "Profile (chosen page only)"
          },
          {
            "key": "page",
            "type": "page",
            "label": "Page (chosen page only)",
            "profile_field": "profile"
          },
          {
            "key": "wrap",
            "type": "bool",
            "label": "Wrap around (next and previous only)",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.utilities.profile",
        "name": "Profile",
        "tooltip": "Go to the next or previous profile, or to a chosen one",
        "icon": "fas:layer-group",
        "scope": "global",
        "settings": [
          {
            "key": "mode",
            "type": "choice",
            "label": "Go to",
            "default": "next",
            "options": [
              {
                "label": "A chosen profile",
                "value": "profile"
              },
              {
                "label": "Next profile",
                "value": "next"
              },
              {
                "label": "Previous profile",
                "value": "previous"
              }
            ]
          },
          {
            "key": "profile",
            "type": "profile",
            "label": "Profile (chosen profile only)"
          },
          {
            "key": "wrap",
            "type": "bool",
            "label": "Wrap around (next and previous only)",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.utilities.brightness",
        "name": "Brightness",
        "tooltip": "Raise, lower or set the display brightness",
        "icon": "fas:sun",
        "scope": "global",
        "returns": "The new brightness level, 0-100 (the first changed monitor's)",
        "settings": [
          {
            "key": "mode",
            "type": "choice",
            "label": "Mode",
            "default": "increase",
            "options": [
              {
                "label": "Increase",
                "value": "increase"
              },
              {
                "label": "Decrease",
                "value": "decrease"
              },
              {
                "label": "Set",
                "value": "set"
              }
            ]
          },
          {
            "key": "value",
            "type": "int",
            "label": "Value (%)",
            "default": 10,
            "min": 0,
            "max": 100
          },
          {
            "key": "monitor",
            "type": "choice",
            "label": "Monitor",
            "default": "all",
            "options": [
              {
                "label": "All monitors",
                "value": "all"
              }
            ],
            "options_source": "monitors"
          }
        ]
      },
      {
        "id": "com.decker.utilities.deck-brightness",
        "name": "Deck Brightness",
        "tooltip": "Raise, lower or set the Stream Deck's own brightness",
        "icon": "fas:toolbox",
        "scope": "global",
        "returns": "The brightness level sent, 0-100 (the server clamps it to 1-100)",
        "settings": [
          {
            "key": "mode",
            "type": "choice",
            "label": "Mode",
            "default": "increase",
            "options": [
              {
                "label": "Increase",
                "value": "increase"
              },
              {
                "label": "Decrease",
                "value": "decrease"
              },
              {
                "label": "Set",
                "value": "set"
              }
            ]
          },
          {
            "key": "value",
            "type": "int",
            "label": "Value (%)",
            "default": 10,
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": "com.decker.utilities.sleep",
        "name": "Sleep",
        "tooltip": "Put the computer to sleep",
        "icon": "fas:moon",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.utilities.lock",
        "name": "Lock",
        "tooltip": "Lock the screen",
        "icon": "fas:lock",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.utilities.sleep-press",
        "name": "Sleep or cancel",
        "tooltip": "Cancels this Sleep card's countdown, or puts the computer to sleep when none is running",
        "icon": "fas:moon",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.utilities.sleep-after",
        "name": "Sleep after",
        "tooltip": "Starts (or restarts) this Sleep card's countdown to sleep",
        "icon": "fas:moon",
        "scope": "plugin",
        "settings": [
          {
            "key": "minutes",
            "type": "int",
            "label": "Minutes",
            "default": 1,
            "min": 1,
            "max": 1440
          }
        ]
      },
      {
        "id": "com.decker.utilities.sleep-cancel",
        "name": "Cancel sleep countdowns",
        "tooltip": "Cancels every running Sleep countdown. Countdowns keep running when a Sleep key is removed or its page is left; use this to stop the ones of removed keys",
        "icon": "fas:ban",
        "scope": "global",
        "returns": "How many countdowns were cancelled",
        "settings": []
      },
      {
        "id": "com.decker.utilities.timer-toggle",
        "name": "Timer start or pause",
        "tooltip": "Starts this Timer card, pauses it while it runs, resumes it while paused, restarts it when it has finished",
        "icon": "fas:stopwatch",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.utilities.timer-reset",
        "name": "Timer reset",
        "tooltip": "Stops this Timer card and shows its full duration again",
        "icon": "fas:rotate-left",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.utilities.stopwatch-toggle",
        "name": "Stopwatch start or pause",
        "tooltip": "Starts this Stopwatch card, or pauses it while it runs",
        "icon": "fas:stopwatch",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.utilities.stopwatch-reset",
        "name": "Stopwatch reset",
        "tooltip": "Stops this Stopwatch card and sets it back to 0:00",
        "icon": "fas:rotate-left",
        "scope": "plugin",
        "settings": []
      }
    ],
    "icon_packs": [
      {
        "id": "com.decker.utilities.counter-icons",
        "name": "Counter icons",
        "path": "iconpack"
      }
    ],
    "variables": [
      {
        "name": "brightness_level",
        "description": "First monitor's brightness, 0-100 (empty if no monitor)"
      },
      {
        "pattern": "brightness_level_{monitor}",
        "description": "Brightness of monitor N (1-based), 0-100"
      },
      {
        "name": "deck_brightness_level",
        "description": "First connected deck's brightness, 0-100 (empty if unknown)"
      },
      {
        "pattern": "deck_brightness_level_{device}",
        "description": "Brightness of the deck with this device id, 0-100"
      },
      {
        "name": "sleep_in",
        "description": "Time until the soonest running Sleep countdown, m:ss or h:mm:ss (empty if none)"
      }
    ],
    "presets": [
      {
        "id": "com.decker.utilities.preset-brightness-up",
        "name": "Brightness Up",
        "tooltip": "Raise the display brightness by 10%",
        "icon": "fas:sun",
        "appearance": {
          "icon": {
            "ref": "fas:sun",
            "color": "#ffffff"
          }
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.brightness",
            "args": {
              "mode": "increase",
              "value": 10
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.preset-brightness-down",
        "name": "Brightness Down",
        "tooltip": "Lower the display brightness by 10%",
        "icon": "fas:sun",
        "appearance": {
          "icon": {
            "ref": "fas:sun",
            "color": "#ffffff"
          }
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.brightness",
            "args": {
              "mode": "decrease",
              "value": 10
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.preset-deck-brightness-up",
        "name": "Deck Brightness Up",
        "tooltip": "Raise the Stream Deck's brightness by 10%",
        "icon": "fas:tv",
        "appearance": {
          "icon": {
            "ref": "fas:tv",
            "color": "#ffffff"
          }
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.deck-brightness",
            "args": {
              "mode": "increase",
              "value": 10
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.preset-deck-brightness-down",
        "name": "Deck Brightness Down",
        "tooltip": "Lower the Stream Deck's brightness by 10%",
        "icon": "fas:tv",
        "appearance": {
          "icon": {
            "ref": "fas:tv",
            "color": "#ffffff"
          }
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.deck-brightness",
            "args": {
              "mode": "decrease",
              "value": 10
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.preset-lock",
        "name": "Lock screen",
        "tooltip": "Lock the screen",
        "icon": "fas:lock",
        "appearance": {
          "icon": {
            "ref": "fas:lock",
            "color": "#ffffff"
          }
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.lock"
          }
        }
      }
    ]
  }
}
