{
  "format": 3,
  "id": "com.decker.utilities",
  "name": "Utilities",
  "version": "1.0.0",
  "author": "Decker",
  "description": "Brightness, sleep, timer, stopwatch, counter, page and profile keys.",
  "homepage": "https://github.com/valsr/decker-plugins",
  "icon": "icons/utilities",
  "category": "Utilities",
  "decker": ">=0.7.2",
  "platforms": [
    "linux",
    "windows",
    "macos"
  ],
  "runtime": {
    "type": "python",
    "entry": "plugin.py",
    "requirements": [
      "pillow>=12",
      "screen-brightness-control; sys_platform != \"darwin\"",
      "jeepney; sys_platform == \"linux\""
    ]
  },
  "contributes": {
    "cards": [
      {
        "id": "com.decker.utilities.counter",
        "name": "Counter",
        "tooltip": "Press to count up, double press to count down, long press to reset",
        "icon": "icons/counter",
        "appearance": {
          "background": "#1f618d"
        },
        "bindings": {
          "press": {
            "action": "com.decker.utilities.counter-increment",
            "args": {
              "step": 1
            }
          },
          "double_press": {
            "action": "com.decker.utilities.counter-decrement",
            "args": {
              "step": 1
            }
          },
          "long_press": {
            "action": "com.decker.utilities.counter-reset"
          }
        },
        "settings": [
          {
            "section": "Counting"
          },
          {
            "key": "max",
            "type": "int",
            "label": "Max count",
            "default": 0,
            "min": 0,
            "max": 99999,
            "special_value": "∞ (no limit)"
          }
        ]
      },
      {
        "id": "com.decker.utilities.page",
        "name": "Page",
        "tooltip": "Go to the next or previous page, or to a chosen one",
        "icon": "fas:file",
        "appearance": {
          "background": "#000000"
        },
        "settings": [
          {
            "key": "color",
            "type": "color",
            "label": "Icon colour",
            "default": "#ffffff",
            "alpha": true
          }
        ],
        "bindings": {
          "press": {
            "action": "com.decker.utilities.page",
            "args": {
              "mode": "next",
              "wrap": false
            }
          }
        }
      },
      {
        "id": "com.decker.utilities.profile",
        "name": "Profile",
        "tooltip": "Go to the next or previous profile, or to a chosen one",
        "icon": "fas:layer-group",
        "appearance": {
          "background": "#000000"
        },
        "settings": [
          {
            "key": "color",
            "type": "color",
            "label": "Icon colour",
            "default": "#ffffff",
            "alpha": true
          }
        ],
        "bindings": {
          "press": {
            "action": "com.decker.utilities.profile",
            "args": {
              "mode": "next",
              "wrap": false
            }
          }
        }
      }
    ],
    "actions": [
      {
        "id": "com.decker.utilities.counter-increment",
        "name": "Count up",
        "tooltip": "Adds the step to the Counter card's count",
        "icon": "icons/counter",
        "scope": "plugin",
        "settings": [
          {
            "key": "step",
            "type": "int",
            "label": "Step",
            "default": 1,
            "min": 1,
            "max": 9999
          }
        ]
      },
      {
        "id": "com.decker.utilities.counter-decrement",
        "name": "Count down",
        "tooltip": "Subtracts the step from the Counter card's count",
        "icon": "icons/counter",
        "scope": "plugin",
        "settings": [
          {
            "key": "step",
            "type": "int",
            "label": "Step",
            "default": 1,
            "min": 1,
            "max": 9999
          }
        ]
      },
      {
        "id": "com.decker.utilities.counter-reset",
        "name": "Reset count",
        "tooltip": "Sets the Counter card's count back to 0",
        "icon": "icons/counter",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.utilities.page",
        "name": "Page",
        "tooltip": "Go to the next or previous page, or to a chosen one",
        "icon": "fas:file",
        "scope": "global",
        "settings": [
          {
            "key": "mode",
            "type": "choice",
            "label": "Go to",
            "default": "next",
            "options": [
              {
                "label": "A chosen page",
                "value": "page"
              },
              {
                "label": "Next page",
                "value": "next"
              },
              {
                "label": "Previous page",
                "value": "previous"
              }
            ]
          },
          {
            "key": "profile",
            "type": "profile",
            "label": "Profile (chosen page only)"
          },
          {
            "key": "page",
            "type": "page",
            "label": "Page (chosen page only)",
            "profile_field": "profile"
          },
          {
            "key": "wrap",
            "type": "bool",
            "label": "Wrap around (next and previous only)",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.utilities.profile",
        "name": "Profile",
        "tooltip": "Go to the next or previous profile, or to a chosen one",
        "icon": "fas:layer-group",
        "scope": "global",
        "settings": [
          {
            "key": "mode",
            "type": "choice",
            "label": "Go to",
            "default": "next",
            "options": [
              {
                "label": "A chosen profile",
                "value": "profile"
              },
              {
                "label": "Next profile",
                "value": "next"
              },
              {
                "label": "Previous profile",
                "value": "previous"
              }
            ]
          },
          {
            "key": "profile",
            "type": "profile",
            "label": "Profile (chosen profile only)"
          },
          {
            "key": "wrap",
            "type": "bool",
            "label": "Wrap around (next and previous only)",
            "default": false
          }
        ]
      }
    ],
    "icon_packs": [
      {
        "id": "com.decker.utilities.counter-icons",
        "name": "Counter icons",
        "path": "iconpack"
      }
    ],
    "variables": [
      {
        "name": "brightness_level",
        "description": "First monitor's brightness, 0-100 (empty if no monitor)"
      }
    ]
  }
}
