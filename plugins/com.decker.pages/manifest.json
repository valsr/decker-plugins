{
  "format": 2,
  "id": "com.decker.pages",
  "name": "Pages",
  "version": "1.3.0",
  "author": "Decker",
  "description": "Keys for moving between a device's pages.",
  "homepage": "https://github.com/valsr/decker-plugins",
  "icon": "icons/pages",
  "category": "Utilities",
  "decker": ">=0.6",
  "runtime": { "type": "python", "entry": "plugin.py" },
  "contributes": {
    "cards": [
      {
        "id": "com.decker.pages.next",
        "name": "Next page",
        "tooltip": "Go to the next page",
        "icon": "icons/pages",
        "gestures": ["press"],
        "appearance": { "background": "#000000" },
        "settings": [
          { "key": "wrap", "type": "bool", "label": "Wrap around", "default": false },
          { "key": "color", "type": "color", "label": "Icon colour", "default": "#ffffff", "alpha": true }
        ]
      },
      {
        "id": "com.decker.pages.previous",
        "name": "Previous page",
        "tooltip": "Go to the previous page",
        "icon": "icons/pages",
        "gestures": ["press"],
        "appearance": { "background": "#000000" },
        "settings": [
          { "key": "wrap", "type": "bool", "label": "Wrap around", "default": false },
          { "key": "color", "type": "color", "label": "Icon colour", "default": "#ffffff", "alpha": true }
        ]
      },
      {
        "id": "com.decker.pages.goto",
        "name": "Go to page",
        "tooltip": "Go to a chosen page, in this or another profile",
        "icon": "icons/pages",
        "gestures": ["press"],
        "appearance": { "background": "#000000" },
        "settings": [
          { "key": "profile", "type": "profile", "label": "Profile" },
          { "key": "page", "type": "page", "label": "Page", "profile_field": "profile" }
        ]
      }
    ]
  }
}
